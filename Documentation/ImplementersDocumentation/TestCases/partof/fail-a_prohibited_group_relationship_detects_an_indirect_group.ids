  <info>
    <title>A prohibited group relationship detects an indirect group</title>
    <description>Generated via code automation in the Ids Repository on github.</description>
  </info>
  <specifications>
    <specification name="A prohibited group relationship detects an indirect group" ifcVersion="IFC4">
      <applicability maxOccurs="unbounded">
        <entity>
          <name>
            <simpleValue>IFCDUCTSEGMENT</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <partOf relation="IFCRELASSIGNSTOGROUP" cardinality="prohibited">
          <entity>
